# --- Database ---------------------------------------------------------------
# Real Postgres (recommended for production; `docker compose up -d`):
#   DATABASE_URL=postgres://iole:iole@localhost:5432/iole
# Embedded Postgres for local dev with no Docker (single process only, so the
# engine runs inside the web server — set ENGINE_INPROCESS=1):
DATABASE_URL=pglite://.data/pglite
ENGINE_INPROCESS=1

# --- LLM --------------------------------------------------------------------
# LLM_MODE=anthropic uses Claude; LLM_MODE=mock returns deterministic fixtures
# (lets the whole loop run without an API key).
LLM_MODE=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_CLASSIFIER_MODEL=claude-opus-5-5

# --- Sending ----------------------------------------------------------------
# mock = simulated provider (delivery, bounces, replies) for end-to-end testing.
SENDER_PROVIDER=mock
# Seconds of simulated latency per "hour" of real time in the mock provider.
MOCK_TIME_SCALE_SECONDS_PER_HOUR=2

# --- App --------------------------------------------------------------------
APP_URL=http://localhost:3000
# 32+ random chars; encrypts stored MCP tokens.
APP_SECRET=change-me-to-a-long-random-string-0123456789
