[Unit]
Description=Pegasusbound event consumer
Documentation=https://docs.pegasusbound.com/development/bare-metal/
After=network-online.target postgresql.service redis.service nats.service pegasusbound-backend.service
Wants=network-online.target

[Service]
Type=simple
User=pegasusbound
Group=pegasusbound
EnvironmentFile=/etc/pegasusbound/pegasusbound.env
WorkingDirectory=/opt/pegasusbound
ExecStart=/opt/pegasusbound/bin/consumer
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/pegasusbound

[Install]
WantedBy=multi-user.target
