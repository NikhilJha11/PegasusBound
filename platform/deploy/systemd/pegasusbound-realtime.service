[Unit]
Description=Pegasusbound realtime service (Phoenix websocket fanout)
Documentation=https://docs.pegasusbound.com/development/bare-metal/
After=network-online.target postgresql.service redis.service
Wants=network-online.target

[Service]
Type=simple
User=pegasusbound
Group=pegasusbound
EnvironmentFile=/etc/pegasusbound/pegasusbound.env
# A mix release only starts its HTTP listener when PHX_SERVER is set.
Environment=PHX_SERVER=true
Environment=HOME=/var/lib/pegasusbound
WorkingDirectory=/opt/pegasusbound/realtime
ExecStart=/opt/pegasusbound/realtime/bin/realtime start
ExecStop=/opt/pegasusbound/realtime/bin/realtime stop
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/pegasusbound

[Install]
WantedBy=multi-user.target
